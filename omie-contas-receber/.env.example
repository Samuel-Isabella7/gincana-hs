# ----------------------------------------------------------------- Omie
# Sem estas duas variáveis o sistema roda em "modo demonstração" (dados fictícios).
OMIE_APP_KEY=
OMIE_APP_SECRET=
# Opcional: buscar o boleto de cada título ao listar (1 chamada por título — deixe 0 em listas grandes)
OMIE_BUSCAR_BOLETOS=0
# Opcionais de ajuste fino
# OMIE_BASE_URL=https://app.omie.com.br/api/v1
# OMIE_TIMEOUT_MS=30000
# OMIE_INTERVALO_MS=260

# ------------------------------------------------------------- Supabase
# Sem estas variáveis contratos/auditoria/config vão para .data/store.json (só desenvolvimento).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Sessão
# Segredo usado para assinar o cookie de sessão. Gere com: openssl rand -base64 32
SESSION_SECRET=

# Usuário criado no primeiro acesso (troque a senha depois de entrar)
ADMIN_USUARIO=admin
ADMIN_SENHA=
